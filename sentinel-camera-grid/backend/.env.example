# Sentinel Backend — Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to GitHub

# Your registered Sentinel email (@ will be encoded as %40 in RTSP URLs)
SENTINEL_EMAIL=your-email@example.com

# Your Sentinel access password
SENTINEL_PASSWORD=your-password-here

# Backend port (default 3001)
PORT=3001

# Sentinel CDN host (HLS)
SENTINEL_CDN_HOST=https://cctv.corp8.cloud

# Sentinel direct IP (RTSP / WebRTC)
SENTINEL_DIRECT_IP=103.250.160.189
SENTINEL_RTSP_PORT=8554
SENTINEL_WHEP_PORT=8889

# How often to refresh camera health status (milliseconds)
HEALTH_CHECK_INTERVAL_MS=30000

# How often to refresh the camera catalogue (milliseconds)
CATALOGUE_REFRESH_INTERVAL_MS=300000
